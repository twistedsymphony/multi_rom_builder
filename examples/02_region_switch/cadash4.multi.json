  "games": {
    "cadash": {
      "_how": "Each region patches its own two program ROMs (ic11, ic15) with its own IPS files, then joins them. The same 512K program image goes into prg1 and fix1 because that is how the TASUKA-M8 multi's Cadash address map reads it. expect holds the CRC the patched prg1 data must have, so a wrong or outdated IPS stops the build.",
      "title": "Cadash (World) [ported]",
      "sets": ["cadash"],
      "roms": {"c21_14.ic11": ["5daf13fb", 131072], "c21_16.ic15": ["cbaa2e75", 131072], "c21_13.ic10": ["6b9e0ee9", 131072], "c21_17.ic14": ["bf9a578a", 131072], "c21-02.9": ["205883b9", 524288], "c21-01.1": ["1ff6f39c", 524288], "c21-08.38": ["dca495a0", 65536]},
      "steps": [
        ["ts", "-ipsapply", "kit:ips/cadash_asuka_ic11.ips", "rom:c21_14.ic11", "ic11.bin"],
        ["ts", "-ipsapply", "kit:ips/cadash_asuka_ic15.ips", "rom:c21_16.ic15", "ic15.bin"],
        ["ts", "-interleave", "ic11.bin", "ic15.bin", "prg1.bin"],
        ["ts", "-interleave", "rom:c21_13.ic10", "rom:c21_17.ic14", "prg2.bin"]
      ],
      "parts": {"prg1": ["prg1.bin", "prg2.bin"], "fix1": ["prg1.bin", "prg2.bin"], "scn1": "rom:c21-02.9", "obj1": "rom:c21-01.1", "snd1": "rom:c21-08.38"},
      "notes": "Runs at 8 MHz with the 68000 clock switch depopulated; needs U2 rev 1.3.",
      "expect": {"prg1": "1f071e7e"}
    },
